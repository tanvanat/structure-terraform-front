      "provider": "provider[\"registry.terraform.io/hashicorp/local\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "content": "Host prod-non\r\n  HostName 10.112.2.65\r\n  User ubuntu\r\n  IdentityFile ~/.ssh/Fronttest.pem\r\n  IdentitiesOnly yes\r\n  ForwardAgent yes\r\n  StrictHostKeyChecking no\r\n  UserKnownHostsFile=/dev/null\r\n  PreferredAuthentications publickey\r\n  ConnectTimeout 10\r\n  ServerAliveInterval 30\r\n  ServerAliveCountMax 3\r\n\r\n# Any RFC1918 targets go via bastion\r\nHost 10.* 192.168.* 172.16.* 172.17.* 172.18.* 172.19.* 172.2[0-9].* 172.3[0-1].*\r\n  User ubuntu\r\n  ProxyJump prod-non\r\n  ForwardAgent yes\r\n  IdentitiesOnly yes\r\n  StrictHostKeyChecking no\r\n  UserKnownHostsFile=/dev/null\r\n  PreferredAuthentications publickey\r\n  ConnectTimeout 10\r\n  ServerAliveInterval 30\r\n  ServerAliveCountMax 3\r\n\r\n# Safety default so Ansible never falls back to passwords and hangs\r\nHost *\r\n  BatchMode yes\r\n  IdentitiesOnly yes\r\n",
            "content_base64": null,
            "content_base64sha256": "qiolOpTpHWWiyIgw/OR4FWrnCDtnhyUpK3sa5NE03DM=",
